{
  "expo": {
    "name": "Sproutly",
    "slug": "sproutly",
    "version": "0.1.3",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Sproutly \u2014 From seed to flourishing"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alambda.sproutly"
    },
    "android": {
      "package": "com.alambda.sproutly",
      "versionCode": 4,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose plant photos for your private growing journal.",
          "cameraPermission": "Photograph your plant for a care assessment."
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Record a short plant-care question only when you choose the microphone.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Use the microphone for live Plant Doctor dictation and voice calls only when you choose.",
          "speechRecognitionPermission": "Show live captions of your plant-care questions."
        }
      ]
    ],
    "icon": "./icon-512.png"
  }
}
