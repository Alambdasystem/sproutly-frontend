    "expo": "~55.0.0",
    "expo-asset": "55.0.20",
    "expo-audio": "~55.0.18",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.0",
    "expo-image-picker": "~55.0.0",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-speech": "~55.0.18",
    "expo-speech-recognition": "3.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-purchases": "11.0.0",
